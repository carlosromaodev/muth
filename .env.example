# Template de referência. Preferir `.venv/bin/muth init` para gerar chaves locais.
MUTH_ENGINE_MODE=demo
# Para inferência real, provisionar modelos explicitamente e mudar para biometric.
# MUTH_BIOMETRIC_MANIFEST=models/biometrics/manifest.json
MUTH_LEARNING_ENABLED=true
MUTH_LEARNING_INTERVAL_SECONDS=300
MUTH_DATABASE_URL=sqlite:///./data/muth.db
# Chave Fernet válida obrigatória para DB persistente; gerada pelo comando init.
MUTH_DATA_KEY=
# Lista JSON de {tenant_id,key_id,key_sha256,scopes}. Chaves reais ficam no backend.
MUTH_TENANTS=[]
MUTH_MAX_UPLOAD_BYTES=5242880
MUTH_MAX_REQUEST_BYTES=11534336
MUTH_MAX_CONTROL_REQUEST_BYTES=65536
MUTH_REQUEST_BODY_TIMEOUT_SECONDS=120
MUTH_MAX_INFERENCE_REQUESTS=2
MUTH_CAPTURE_PORTAL_ENABLED=true
MUTH_CAPTURE_TENANT_ID=capture-portal
MUTH_CAPTURE_POLICY_VERSION=capture-privacy-v1
MUTH_CAPTURE_MAX_REQUEST_BYTES=16777216
MUTH_CAPTURE_RATE_LIMIT_PER_MINUTE=120
MUTH_CAPTURE_CREATION_LIMIT_PER_MINUTE=10
MUTH_CAPTURE_MAX_SESSIONS=10000
MUTH_CAPTURE_RETENTION_DAYS=1
MUTH_CAPTURE_LEARNING_ENABLED=true
MUTH_CAPTURE_LEARNING_POLICY_VERSION=capture-learning-v1
MUTH_CAPTURE_LEARNING_RETENTION_DAYS=30
MUTH_DOCUMENT_OCR_ENABLED=true
MUTH_DOCUMENT_OCR_EXECUTABLE=tesseract
MUTH_DOCUMENT_OCR_LANGUAGES=por+eng
MUTH_DOCUMENT_OCR_TIMEOUT_SECONDS=12
MUTH_IDENTITY_ENROLLMENT_ENABLED=true
MUTH_IDENTITY_ENROLLMENT_POLICY_VERSION=identity-enrollment-v1
MUTH_IDENTITY_RETENTION_DAYS=365
MUTH_IDENTITY_MAX_PROFILES=10000
MUTH_MAX_IMAGE_PIXELS=12000000
MUTH_SESSION_TTL_SECONDS=1800
MUTH_RETENTION_DAYS=30
MUTH_PROCESSING_LEASE_SECONDS=120
MUTH_RATE_LIMIT_PER_MINUTE=120
